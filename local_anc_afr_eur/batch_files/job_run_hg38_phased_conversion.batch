#!/bin/bash
#SBATCH --nodes=1
#SBATCH --partition=amilan
#SBATCH --ntasks=8
#SBATCH --job-name="run_hg38_phased_conversion"
#SBATCH -o "/scratch/alpine/sslack@xsede.org/ortega/rfmix_wgs/input/job_%x_chr%a.out"
#SBATCH -e "/scratch/alpine/sslack@xsede.org/ortega/rfmix_wgs/input/job_%x_chr%a.err"
#SBATCH --account=amc-general
#SBATCH --time=00:30:00
#SBATCH --mem=5G
#SBATCH --array=1,2,3,6,16
#SBATCH --qos=normal

# TO NOTE: update the variables to set the data directory (data_dir), the output
# directory (out_dir), code directory (code_dir), the minimum imputation Rsq to
# keep when filtering imputed data (min_rsq, set to 0 for WGS input), thread
# number (nr_threads), the genome build of the input data (build, either hg38 or
# hg19), the list of chromosomes want to run (batch) for the given single-
# chromosome VCF file name structure for that batch (input_vcf).

# Set inputs

# Test imputed data
# RKJCOLLAB="/Users/slacksa/Library/CloudStorage/OneDrive-TheUniversityofColoradoDenver"
# code_dir="/Users/slacksa/repos/local_ancestry_analysis/local_anc_afr_eur"
# nr_threads=8
# data_dir="${RKJCOLLAB}/Collabs/ortega/data/pipeline_test_data/local_anc_afr_eur"
# out_dir="${data_dir}/imp_output"
# input_vcf='${data_dir}/imp_output/chr${chr}_small_noinfo_filt_tags_maf0.03_snp_id.vcf.gz'
# min_rsq=0.7
# build="hg38"
# batch="22"

# Re-run SARP WGS data
code_dir="/projects/sslack@xsede.org/repos/local_ancestry_analysis/local_anc_afr_eur"
nr_threads=$SLURM_NTASKS
data_dir="/scratch/alpine/sslack@xsede.org/ortega/rfmix_wgs/input"
out_dir='${data_dir}/chr${chr}'
input_vcf='${data_dir}/chr${chr}/chr${chr}_noinfo_filt_tags_maf0.03_snp_id.vcf.gz'
min_rsq=0
build="hg38"
batch=$SLURM_ARRAY_TASK_ID

for chr in $batch; do
	input_vcf_chr=$(eval "echo $input_vcf")
    out_dir_chr=$(eval "echo $out_dir")
    mkdir "$out_dir_chr"
	cont_dir=$(dirname "${code_dir}")

	apptainer exec --bind ${data_dir}:${data_dir} --bind ${code_dir}:${code_dir} \
    	${cont_dir}/local_ancestry_analysis.sif \
		bash ${code_dir}/run_hg38_phased_conversion.sh \
			"$input_vcf_chr" \
			"$out_dir_chr" \
			"$nr_threads" \
			"$code_dir" \
			"$min_rsq" \
			"$build"
done
