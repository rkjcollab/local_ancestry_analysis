#!/bin/bash
#SBATCH --nodes=1
#SBATCH --partition=amilan
#SBATCH --ntasks=24
#SBATCH --job-name="prep_input_phased"
#SBATCH -o "/scratch/alpine/sslack@xsede.org/ortega/rfmix_wgs/input/job_%x_chr%a.out"
#SBATCH -e "/scratch/alpine/sslack@xsede.org/ortega/rfmix_wgs/input/job_%x_chr%a.err"
#SBATCH --account=amc-general
#SBATCH --time=03:00:00
#SBATCH --mem=40G
#SBATCH --array=5,8,10,17

# TO NOTE: depending on where running may have additional steps so apptainer
# ready to run shell below.
# TO NOTE: update the variables to set the data directory (data_dir), the output
# directory (out_dir), code directory (code_dir), the minimum MAF to keep when
# filtering (min_maf), thread number (nr_threads), list of sample IDs to include
# (samp_ids), the list of chromosomes want to run (batch), and the single-
# chromosome VCF file name structure for that batch (input_vcf).

# Set inputs

# Test imputed data
# code_dir="/Users/slacksa/repos/local_ancestry_analysis/local_anc_afr_eur"
# nr_threads=8
# min_maf=0.03
# data_dir="${RKJCOLLAB}/Collabs/ortega/data/pipeline_test_data/local_anc_afr_eur"
# out_dir="${data_dir}/imp_output"
# samp_ids="${data_dir}/imp/chr22_small_sample_list_subset.txt"
# input_vcf='${data_dir}/imp/chr${chr}_small.vcf'
# batch=22

# Re-run SARP WGS data
code_dir="/projects/sslack@xsede.org/repos/local_ancestry_analysis"
min_maf=0.03
nr_threads=$SLURM_NTASKS
data_dir="/scratch/alpine/sslack@xsede.org/ortega/rfmix_wgs/input"
out_dir='${data_dir}/chr${chr}'
input_vcf='${data_dir}/chr${chr}.vcf.gz'
samp_ids="${data_dir}/sample_ids_for_laaa.txt"
batch=$SLURM_ARRAY_TASK_ID

for chr in $batch; do
    input_vcf_chr=$(eval "echo $input_vcf")
    out_dir_chr=$(eval "echo $out_dir")
    mkdir "$out_dir_chr"
    cont_dir=$(dirname "${code_dir}")

    apptainer exec --bind ${data_dir}:${data_dir} --bind ${code_dir}:${code_dir} \
        ${cont_dir}/local_ancestry_analysis.sif \
        bash ${code_dir}/prep_input_phased.sh \
            "$input_vcf_chr" \
            "$out_dir_chr" \
            "$min_maf" \
            "$nr_threads" \
            "$samp_ids"
done
